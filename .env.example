# Copy to .env (VPS / Docker) or .env.local (local `npm run dev`).
# Never commit the real file.

# Go API base URL, used server-side only (never sent to the browser).
#   VPS (Docker, same network as superproject): http://coffeeshop_api:8081
#   Local development:                          http://localhost:8081
API_BASE_URL=http://coffeeshop_api:8081

# Business used at sign-in when the "Business code" field is left empty.
DEFAULT_BUSINESS_SLUG=yorlapa-cafe

# Docker network created by the superproject stack (docker network ls).
SUPERPROJECT_NETWORK=superproject_coffeeshop_net
